<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="using:UniversityManager.ViewModels"
             xmlns:models="using:UniversityManager.Models"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UniversityManager.Views.SubjectList"
             x:CompileBindings="True"
             x:DataType="vm:SubjectListViewModel">
        <UserControl.DataContext>
        <vm:SubjectListViewModel/>
    </UserControl.DataContext>
    <Border Padding="10">
        <StackPanel>
            <ItemsControl ItemsSource="{Binding MySubjects}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:Subject">
                        <!-- Item container for each subject -->
                        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Margin="0,10">
                            <StackPanel Margin="10">
                                <!-- Subject name label -->
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                                
                                <!-- Buttons for Enroll and Details -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
<!-- 
                                    <Button Content="Enroll" 
                                    
                                            Command="{Binding enroll}"
                                            CommandParameter="{Binding}"
                                            
                                            Width="100"/>
                                 -->
                                    <Button Content="Details" 
                                               Command="{Binding details}"
                                               CommandParameter="{Binding}"
                                            
                                            
                                            Width="100"/>
                                           
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>